{
  "openapi": "3.0.3",
  "info": {
    "title": "URL Shortener API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/urls/{code}/stats": {
      "get": {
        "summary": "Click analytics for a link",
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/urls/{code}/expiry": {
      "put": {
        "summary": "Extend the expiry of a link",
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Validation error"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not found"
          },
          "410": {
            "description": "Gone"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Liveness probe",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "x-security-controls": [
    "url-scheme-allowlist",
    "ssrf-block",
    "input-limits",
    "rate-limit",
    "audit-logging"
  ]
}