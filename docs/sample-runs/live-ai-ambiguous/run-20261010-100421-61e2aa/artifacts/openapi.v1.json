{
  "openapi": "3.0.3",
  "info": {
    "title": "URL Shortener API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/urls": {
      "post": {
        "summary": "Create short link with validated target and optional UTC expiry; rate limited",
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Validation error"
          },
          "429": {
            "description": "Too many requests"
          }
        }
      }
    },
    "/r/{code}": {
      "get": {
        "summary": "302 redirect to target; enqueue click non-blocking; 410 if expired; rate limited",
        "responses": {
          "302": {
            "description": "Redirect"
          },
          "404": {
            "description": "Not found"
          },
          "410": {
            "description": "Gone"
          },
          "429": {
            "description": "Too many requests"
          }
        }
      }
    },
    "/{code}": {
      "get": {
        "summary": "Existing legacy redirect, same behavior as /r/{code}",
        "responses": {
          "302": {
            "description": "Redirect"
          },
          "404": {
            "description": "Not found"
          },
          "410": {
            "description": "Gone"
          },
          "429": {
            "description": "Too many requests"
          }
        }
      }
    },
    "/api/urls/{code}": {
      "get": {
        "summary": "Link metadata: target, created, expiry, expired flag",
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      },
      "delete": {
        "summary": "Existing deactivation kept working",
        "responses": {
          "204": {
            "description": "No content"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/urls/{code}/analytics": {
      "get": {
        "summary": "Eventually consistent total click count",
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/api/urls/{code}/stats": {
      "get": {
        "summary": "Existing stats route kept working",
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not found"
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "x-security-controls": [
    "url-scheme-allowlist",
    "ssrf-block",
    "input-limits",
    "rate-limit"
  ]
}